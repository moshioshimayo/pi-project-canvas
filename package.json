{
  "name": "pi-project-canvas",
  "version": "0.3.0",
  "description": "A private, project-shared Excalidraw board for Pi over Tailscale",
  "repository": {
    "type": "git",
    "url": "https://github.com/moshioshimayo/pi-project-canvas.git"
  },
  "homepage": "https://github.com/moshioshimayo/pi-project-canvas#readme",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "excalidraw",
    "tailscale"
  ],
  "files": [
    "index.ts",
    "lib/",
    "dist/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run build && npm test && node scripts/smoke-pi.mjs",
    "verify:comments": "node scripts/smoke-comments.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
